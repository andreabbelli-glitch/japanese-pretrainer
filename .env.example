# Local persistence path. If omitted, the app uses this same default.
DATABASE_URL=./data/japanese-custom-study.db
DATABASE_AUTH_TOKEN=

# Optional app auth for public deployment.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_PASSWORD=
AUTH_SESSION_SECRET=

# Optional webhook used by `pnpm content:import` to invalidate deployed
# Next/Vercel caches after a successful content sync.
CONTENT_CACHE_REVALIDATE_URL=
CONTENT_CACHE_REVALIDATE_SECRET=

# Required on Vercel for the FSRS optimizer and Daily Kanji snapshot cron routes.
CRON_SECRET=

# Private bearer token used by the personal Daily Kanji iOS app to refresh the
# offline-first dataset. The WidgetKit extension reads the shared App Group
# cache and does not use this token.
DAILY_KANJI_IOS_SYNC_TOKEN=

# Private single-user bearer token used by Daily Kanji iOS live review APIs.
MOBILE_API_TOKEN=

# Local iOS build setting only: set to 1 when the Apple Developer provisioning
# used for the app includes Push Notifications; otherwise leave it unset/0.
DAILY_KANJI_ENABLE_APNS=0

# Secret used by the GitHub Actions monitor that triggers APNs due-card checks.
MOBILE_NOTIFICATION_MONITOR_SECRET=

# Optional APNs provider credentials for Daily Kanji iOS live review push.
MOBILE_REVIEW_APNS_BUNDLE_ID=
MOBILE_REVIEW_APNS_KEY_ID=
MOBILE_REVIEW_APNS_PRIVATE_KEY=
MOBILE_REVIEW_APNS_TEAM_ID=
MOBILE_REVIEW_APNS_ENVIRONMENT=sandbox

# Optional timeout in ms for each FSRS optimizer preset (default: 4000).
FSRS_OPTIMIZER_TRAINING_TIMEOUT_MS=
